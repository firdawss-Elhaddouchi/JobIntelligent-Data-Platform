// MEASURE FactSales[Gross Profit MTD] =
//     TOTALMTD ( [Gross Profit], DimDate[Date] );

// MEASURE FactSales[Gross Margin % MTD] =
//     DIVIDE ( [Gross Profit MTD], [Revenue MTD] );

// // ---- YTD ----
// MEASURE FactSales[Revenue YTD] =
