// MEASURE FactSales[Revenue YoY %] =
//     DIVIDE ( [Revenue YoY Δ], [Revenue LY] );

// MEASURE FactSales[Gross Profit LY] =
//     CALCULATE ( [Gross Profit], DATEADD ( DimDate[Date], -1, YEAR ) );

// MEASURE FactSales[Gross Profit YoY %] =
//     DIVIDE ( [Gross Profit] - [Gross Profit LY], [Gross Profit LY] );

// MEASURE FactSales[Revenue PM] =
//     CALCULATE ( [Revenue], PARALLELPERIOD ( DimDate[Date], -1, MONTH ) );

// MEASURE FactSales[Revenue MoM Δ] =
//     [Revenue] - [Revenue PM];

// MEASURE FactSales[Revenue MoM %] =
//     DIVIDE ( [Revenue MoM Δ], [Revenue PM] );

