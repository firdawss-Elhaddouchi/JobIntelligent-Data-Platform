// MEASURE FactSales[Gross Profit YTD] =
//     TOTALYTD ( [Gross Profit], DimDate[Date] );

// MEASURE FactSales[Gross Margin % YTD] =
//     DIVIDE ( [Gross Profit YTD], [Revenue YTD] );

// MEASURE FactSales[Units YTD] =
//     TOTALYTD ( [Units], DimDate[Date] );

// MEASURE FactSales[ASP YTD] =
//     DIVIDE ( [Revenue YTD], [Units YTD] );

// // ---- QTD (optional but useful) ----
// MEASURE FactSales[Revenue QTD] =
//     TOTALQTD ( [Revenue], DimDate[Date] );

// MEASURE FactTargets[Target QTD] =
//     TOTALQTD ( FactTargets[Target], DimDate[Date] );

// MEASURE FactSales[Revenue Var vs Target QTD] =
//     [Revenue QTD] - [Target QTD];

// MEASURE FactSales[Revenue Var % vs Target QTD] =
//     DIVIDE ( [Revenue Var vs Target QTD], [Target QTD] );

// // =========================
// // YoY & MoM (Actuals)
// // =========================
// MEASURE FactSales[Revenue LY] =
//     CALCULATE ( [Revenue], DATEADD ( DimDate[Date], -1, YEAR ) );

// MEASURE FactSales[Revenue YoY Δ] =
