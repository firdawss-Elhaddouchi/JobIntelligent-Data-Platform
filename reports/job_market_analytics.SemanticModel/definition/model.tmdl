model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["gold dim_company","gold dim_contract_type","gold dim_date","gold dim_location","gold fact_jobs"]

annotation PBI_ProTooling = ["DevMode"]

ref table 'gold dim_company'
ref table 'gold dim_contract_type'
ref table 'gold dim_date'
ref table 'gold dim_location'
ref table 'gold fact_jobs'
ref table Calculations

ref cultureInfo en-US

