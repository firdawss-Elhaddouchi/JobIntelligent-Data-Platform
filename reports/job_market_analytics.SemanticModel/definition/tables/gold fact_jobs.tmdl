	column 'salary_avg (bins)' =
			IF(
				ISBLANK('gold fact_jobs'[salary_avg]),
				BLANK(),
				IF(
					'gold fact_jobs'[salary_avg] >= 0,
					ROUNDDOWN('gold fact_jobs'[salary_avg] / 1000, 0) * 1000,
					ROUNDUP('gold fact_jobs'[salary_avg] / 1000, 0) * 1000
				)
			)
		formatString: 0.00
